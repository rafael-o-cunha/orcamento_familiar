# Copie para infra/.env (o "make setup" faz isso) e ajuste se precisar.
# O infra/.env não vai para o Git. Comentários sempre em linha própria.

COMPOSE_PROJECT_NAME=orcamento-familiar

# ---------- Oracle (container) ----------
ORACLE_IMAGE=gvenzl/oracle-xe:21-slim-faststart
# Senha dos usuários SYS e SYSTEM
ORACLE_PASSWORD=oracle123
DB_PORT=1521
DB_SERVICE=XEPDB1
# Schema da aplicação (criado no primeiro start do container)
DB_USER=ORCAMENTO
DB_PASSWORD=orcamento123

# ---------- WildFly 13 (container) ----------
# Aplicação: http://localhost:8080/orcamento-familiar
APP_PORT=8080
# Console de administração: http://localhost:9990
ADMIN_PORT=9990
# Depuração remota: na IDE, Remote JVM Debug em localhost:8787
DEBUG_PORT=8787
WILDFLY_ADMIN_USER=admin
WILDFLY_ADMIN_PASSWORD=admin123
OJDBC_VERSION=19.24.0.0

# URL que o WildFly do container usa para chegar no Oracle do container.
DB_URL=jdbc:oracle:thin:@oracle:1521/XEPDB1

# ---------- Execução local (WildFly instalado na máquina) ----------
# Caminho do WildFly 13 local; usado por "make deploy-local".
WILDFLY_HOME=
